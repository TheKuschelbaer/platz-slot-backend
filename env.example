# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# Die ".env" selbst wird NICHT mit hochgeladen (siehe .gitignore).

PORT=3001

# Optional: Pfad zur Datenbankdatei. In Produktion (Railway) auf einen
# Ordner zeigen, der auf einem Volume liegt, z. B. /data/platz-slot.db
DB_PATH=./platz-slot.db

# Telegram-Benachrichtigungen (optional – ohne diese zwei Werte wird
# einfach nur geloggt statt wirklich gesendet, kein Fehler)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Link zur Web-App, der in Telegram-Nachrichten mitgeschickt wird (optional)
APP_URL=
